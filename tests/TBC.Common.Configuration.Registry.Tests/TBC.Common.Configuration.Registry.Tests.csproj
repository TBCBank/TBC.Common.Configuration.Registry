<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-windows;net9.0-windows;net8.0-windows;net472</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<LangVersion>latest</LangVersion>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
		<!-- Tests share a Windows Registry key, so they must not run in parallel. -->
		<TestTfmsInParallel>false</TestTfmsInParallel>
		<TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --parallel none</TestingPlatformCommandLineArguments>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="xunit.v3.mtp-v2" Version="4.*" />
	</ItemGroup>

	<ItemGroup Condition=" '$(TargetFramework)' == 'net472' ">
		<PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.*" />
	</ItemGroup>

	<ItemGroup Condition=" '$(TargetFramework)' == 'net8.0-windows' ">
		<PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.*" />
	</ItemGroup>

	<ItemGroup Condition=" '$(TargetFramework)' == 'net9.0-windows' ">
		<PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.0.*" />
	</ItemGroup>

	<ItemGroup Condition=" '$(TargetFramework)' == 'net10.0-windows' ">
		<PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.*" />
	</ItemGroup>

	<ItemGroup>
		<SupportedPlatform Include="Windows" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\TBC.Common.Configuration.Registry\TBC.Common.Configuration.Registry.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Xunit" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="testconfig.json" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
